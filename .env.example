# kSQL Dashboard — アップロード用の認証情報サンプル
# このファイルをコピーして .env を作成し、値を設定してください（.env はコミットされません）。
#   cp .env.example .env
# 使い方: npm run upload （= npm run package + cli-kintone plugin upload）

# kintone のベース URL（末尾スラッシュ不要）
KINTONE_BASE_URL=https://example.cybozu.com

# ログインユーザー名 / パスワード
KINTONE_USERNAME=your-login-name
KINTONE_PASSWORD=your-password

# （任意）Basic 認証を使う環境のみ
# KINTONE_BASIC_AUTH_USERNAME=
# KINTONE_BASIC_AUTH_PASSWORD=
